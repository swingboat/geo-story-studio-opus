{
  "voices": {
    "zh": { "name": "zh-CN-XiaoyiNeural" },
    "kid": { "name": "zh-CN-YunxiaNeural", "rate": 4, "pitch": 6 }
  },
  "segments": [
    { "id": "hook", "voice": "kid", "text": "姐姐，天上亮晶晶的那些，都叫天体吗？", "gap": 0.5 },
    { "id": "def", "text": "差不多！天体，就是宇宙里的“东西”。", "gap": 0.8 },
    { "id": "star", "text": "恒星，自己会发光发热，比如太阳。", "gap": 0.5 },
    { "id": "planet", "text": "行星绕着恒星转，自己不发光，靠反射阳光，比如地球。", "gap": 0.5 },
    { "id": "moon", "text": "卫星绕着行星转，月球就是地球的卫星。", "gap": 0.5 },
    { "id": "comet", "text": "彗星像个脏雪球，靠近太阳，就拖出一条长尾巴。", "gap": 0.5 },
    { "id": "nebula", "text": "星云是一大片气体和尘埃，是恒星出生的地方。", "gap": 0.6 },
    { "id": "more", "text": "还有太空里的小石块流星体、稀薄的星际物质，以及人类送上天的空间站，都是天体。", "captions": ["还有太空里的小石块流星体、", "稀薄的星际物质，", "以及人类送上天的空间站，", "都是天体。"], "gap": 0.9 },
    { "id": "kidQ", "voice": "kid", "text": "那怎么判断，一个东西算不算天体呢？", "gap": 0.4 },
    { "id": "rule", "text": "问三句！", "gap": 0.4 },
    { "id": "q1", "text": "第一，它在太空里吗？", "gap": 0.35 },
    { "id": "q2", "text": "第二，它是实实在在的东西吗？", "gap": 0.35 },
    { "id": "q3", "text": "第三，它自己在运行吗？", "gap": 0.4 },
    { "id": "ruleEnd", "text": "三句都是，才算天体！", "gap": 0.9 },
    { "id": "quizMoon", "text": "考考你：月球？三条都满足，是天体！", "gap": 0.5 },
    { "id": "kidChange", "voice": "kid", "text": "那降落在月球上的嫦娥四号呢？", "gap": 0.4 },
    { "id": "change", "text": "它停在月面，成了月球的一部分，不再独立运行，不算！", "gap": 0.5 },
    { "id": "spot", "text": "太阳黑子是太阳表面的一块区域，也不算。", "gap": 0.9 },
    { "id": "rock", "text": "考试最爱考的，是这块石头。", "gap": 0.4 },
    { "id": "rock1", "text": "在太空里飘，叫流星体，是天体。", "gap": 0.4 },
    { "id": "rock2", "text": "冲进大气层，烧成一道光，叫流星，不是天体。", "gap": 0.4 },
    { "id": "rock3", "text": "落到地面，叫陨石，也不是天体。", "gap": 0.9 },
    { "id": "system", "text": "天体还会抱团：互相吸引、绕着转，就组成天体系统。", "gap": 0.5 },
    { "id": "sys1", "text": "月球绕着地球，是地月系；", "gap": 0.4 },
    { "id": "sys2", "text": "八大行星绕着太阳，是太阳系；", "gap": 0.4 },
    { "id": "sys3", "text": "太阳，又只是银河系几千亿颗恒星中的一颗；", "gap": 0.4 },
    { "id": "sys4", "text": "银河系和无数河外星系，一起组成可观测宇宙。", "gap": 1.0 },
    { "id": "outro", "text": "记住：在太空、有实体、独立运行，就是天体！", "captions": ["记住：", "在太空、有实体、独立运行，", "就是天体！"], "gap": 0.5 },
    { "id": "kidEnd", "voice": "kid", "text": "我记住啦！" }
  ]
}
