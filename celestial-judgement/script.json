{
  "title": "哪些算天体？天体认证处开张了",
  "voice": "zh-CN-XiaoxiaoNeural",
  "voices": {
    "zh": { "name": "zh-CN-XiaoxiaoNeural", "rate": 6 },
    "moon": { "name": "zh-CN-YunxiaNeural", "rate": 4 },
    "nebula": { "name": "zh-CN-XiaoyiNeural", "rate": -4, "pitch": -2 },
    "meteor": { "name": "zh-CN-YunjianNeural", "rate": 12 },
    "spot": { "name": "zh-CN-liaoning-XiaobeiNeural", "rate": 6 },
    "sat": { "name": "zh-CN-YunxiNeural", "rate": 4 }
  },
  "sources": [
    { "title": "Meteors and Meteorites", "publisher": "NASA", "url": "https://science.nasa.gov/solar-system/meteors-meteorites/" },
    { "title": "Sunspots", "publisher": "NASA", "url": "https://science.nasa.gov/sun/sunspots/" },
    { "title": "What Is a Satellite?", "publisher": "NASA Space Place", "url": "https://spaceplace.nasa.gov/satellite/en/" },
    { "title": "Basics of Space Flight, Chapter 1-3", "publisher": "NASA", "url": "https://science.nasa.gov/learn/basics-of-space-flight/chapter1-3/" },
    { "title": "人教版《地理 必修第一册》：天体定义、脚注、太阳活动", "publisher": "人民教育出版社", "url": "http://www.pep.com.cn" }
  ],
  "segments": [
    { "id": "hook", "text": "月球、流星、太阳黑子，都能单独叫天体吗？", "gap": 0.35 },
    { "id": "open", "text": "天体认证处，今天开张！五位选手排队申请。", "gap": 0.4 },
    { "id": "rule", "text": "先看规则：人教版这节课，通常讨论的是天然天体。", "gap": 0.5 },
    { "id": "moonHi", "voice": "moon", "text": "我是月球，地球的天然卫星！", "gap": 0.25 },
    { "id": "moonOk", "text": "认证通过！", "gap": 0.45 },
    { "id": "nebHi", "voice": "nebula", "text": "我是星云，一大团气体和尘埃，软软的，没有硬壳。", "gap": 0.25 },
    { "id": "nebOk", "text": "也通过！天体不一定是坚硬的球。", "gap": 0.5 },
    { "id": "metHi", "voice": "meteor", "text": "我是流星！看我多亮！", "gap": 0.2 },
    { "id": "wait", "text": "等等！这道亮光，是一种现象。", "gap": 0.35 },
    { "id": "body", "text": "真正的物体，是太空里的小石块，叫流星体。", "gap": 0.3 },
    { "id": "enter", "text": "它冲进大气层，才产生了流星这道亮迹。", "gap": 0.35 },
    { "id": "split", "text": "物体和现象，要分开！", "gap": 0.5 },
    { "id": "spotHi", "voice": "spot", "text": "我是太阳黑子，我也算一颗黑色的星星吧？", "gap": 0.25 },
    { "id": "spotNo", "text": "不是哦。黑子是太阳光球层中较暗的区域。", "gap": 0.3 },
    { "id": "spotPart", "text": "它只是比周围暗一些，是太阳的局部，不是另一颗星。", "gap": 0.5 },
    { "id": "satHi", "voice": "sat", "text": "我是人造卫星，还在发射台上，算天体吗？", "gap": 0.25 },
    { "id": "satWait", "text": "还不算。待发射，不等于已入轨。", "gap": 0.3 },
    { "id": "satOrbit", "text": "进入绕地轨道运行后，才是人造天体。", "gap": 0.3 },
    { "id": "satNote", "text": "不过这是补充知识，要和课本范围分开。", "gap": 0.55 },
    { "id": "quiz", "text": "小测验：月球和流星现象，哪个是天然天体？", "gap": 1.3 },
    { "id": "answer", "text": "答案是月球！", "gap": 0.45 },
    { "id": "recap", "text": "记住四个词：对象、现象、局部、运行状态。", "gap": 0.4 },
    { "id": "outro", "text": "关注地理故事工坊，下期见！" }
  ]
}
